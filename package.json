{
  "name": "sms-gateway-backend",
  "version": "1.0.0",
  "description": "SMS Gateway Backend Service",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "npm run build && node --test dist/modules/sms/sms.validation.test.js",
    "start": "node dist/server.js",
    "start:win": "cross-env NODE_ENV=production node dist/server.js",
    "postinstall": "prisma generate || exit 0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/client": "^7.10.1",
    "@prisma/orm-postgres": "^8.0.0-rc.20",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.15",
    "morgan": "^1.10.0",
    "temporal-polyfill": "^1.0.4",
    "prisma": "^8.0.0-rc.27",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.43",
    "cross-env": "^7.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
