// use prisma-8

enum SmsEncoding {
  GSM7
  UNICODE
}

enum MessageDirection {
  INCOMING
  OUTGOING
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
}

enum AttemptStatus {
  SUCCESS
  FAILED
  SKIPPED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  wallet   Wallet?
  messages SmsMessage[]
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Provider {
  id          String  @id @default(uuid())
  code        String  @unique // ROUTE_A, ROUTE_B
  name        String
  priority    Int
  balance     Int
  failureRate Float
  isActive    Boolean @default(true)

  messages SmsMessage[]
  attempts MessageAttempt[]
}

model SmsMessage {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id])

  direction         MessageDirection @default(OUTGOING)
  sender            String
  recipient         String
  normalizedRecipient String

  message           String
  encoding          SmsEncoding
  segments          Int
  creditsCharged    Int

  status            MessageStatus   @default(QUEUED)
  providerId        String?
  provider          Provider?       @relation(fields: [providerId], references: [id])
  providerMessageId String?

  errorMessage      String?
  refundIssued      Boolean         @default(false)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  sentAt            DateTime?

  attempts          MessageAttempt[]

  @@index([userId])
  @@index([status])
  @@index([recipient])
  @@index([normalizedRecipient])
  @@index([createdAt])
  @@index([providerId])
}

model MessageAttempt {
  id          String        @id @default(uuid())
  messageId   String
  message     SmsMessage    @relation(fields: [messageId], references: [id], onDelete: Cascade)

  providerId  String
  provider    Provider      @relation(fields: [providerId], references: [id])

  status      AttemptStatus
  errorCode   String?
  errorMessage String?

  attemptedAt DateTime      @default(now())

  @@index([messageId])
  @@index([providerId, attemptedAt])
  @@index([attemptedAt])
}